<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Настя | Неоновый плеер 💜</title>
    <link rel="stylesheet" href="./styles/style.css">
</head>
<body>
    <!-- Фоновый визуализатор -->
    <div class="background-visualizer" id="backgroundVisualizer">
        <canvas id="bgCanvas"></canvas>
    </div>
    
    <!-- Переливающийся фон -->
    <div class="gradient-bg" id="gradientBg"></div>
    
    <!-- Милые парящие частицы -->
    <div class="particles-container" id="particlesContainer"></div>
    
    <!-- Вспышки -->
    <div class="flash-overlay" id="flashOverlay"></div>
    
    <!-- Основной контент -->
    <div class="content">
        <div class="player-card" id="playerCard">
            <div class="word-box">
                <div class="dynamic-word" id="changingWord">Настя</div>
                <div class="word-shadow"></div>
            </div>
            
            <div class="controls">
                <button class="play-btn" id="playPauseBtn">
                    <span class="play-icon" id="playIcon">▶</span>
                </button>
            </div>
            
            <!-- Регулировка громкости -->
            <div class="volume-control">
                <span class="volume-icon">🔊</span>
                <input type="range" id="volumeSlider" min="0" max="100" value="70" class="volume-slider">
                <span class="volume-value" id="volumeValue">70%</span>
            </div>
            
            <div class="track-name" id="trackName">✨ Нажмите PLAY чтобы начать ✨</div>
            
            <!-- Милые индикаторы -->
            <div class="cute-indicators">
                <span class="cute-dot">💜</span>
                <span class="cute-dot">💗</span>
                <span class="cute-dot">💕</span>
            </div>
        </div>
    </div>

    <script src="./scripts/script.js"></script>
</body>
</html>